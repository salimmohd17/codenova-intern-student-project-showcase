PORT=5005
ADMIN_KEY=replace-with-a-long-private-key
DATABASE_PATH=./data/app.db
# DATABASE_PATH=/tmp/projects.db   ← Vercel uses /tmp (ephemeral)
FRONTEND_ORIGIN=http://localhost:5173
# Set this to the exact Vercel frontend URL, without a trailing slash.
# For multiple frontends, separate origins with commas.
